---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main>
		<img src="/images/LogoCarga.webp" alt="Logo" />
	</main>
</Layout>

<style>
	main {
		min-height: 100vh;
		min-height: 100dvh;
		margin: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: #025fc5;
	}

	img {
		max-width: min(60vw, 400px);
		height: auto;
		display: block;
	}
</style>
